# Web values belong in apps/web/.env.local. This file documents the full
# reconciliation contract without containing usable credentials.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-hi-coworking
NEXT_PUBLIC_EXPECTED_FIREBASE_PROJECT_ID=demo-hi-coworking
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.replace-with-your-mapbox-public-token

# Callable region is fixed in apps/web/src/lib/firebase.ts and the deployed
# Functions project. Keep both at us-central1.
FIREBASE_FUNCTIONS_REGION=us-central1

# Organization search provider control (server only)
EXCHANGE_DISABLE_USASPENDING=0

# Stripe values are server-only. Configure with Firebase secrets/parameters;
# never copy a secret key into a NEXT_PUBLIC variable.
STRIPE_EXPECTED_MODE=test
STRIPE_FOUNDING_PRICE_ID=price_replace_me
STRIPE_FOUNDING_PRODUCT_ID=prod_replace_me
APP_URL=http://localhost:3000

# Optional admin-only Microsoft 365 marketing email
# --------------------------------------------------
# Tenant ID, client ID, mailbox UPN, sender aliases, Reply-To addresses,
# development recipient allowlist, and unsubscribe URL belong in the protected
# Firestore document systemConfig/adminMarketingEmail. They are intentionally
# not NEXT_PUBLIC values.
#
# Store the confidential client credential in Google Secret Manager. The
# default secret name is MICROSOFT_MARKETING_CLIENT_SECRET. It is read only
# when an authorized marketing send is attempted, so its absence must not block
# deployment or operation of profile, organization, claims, seed, or Exchange
# Functions.
#
# No SendGrid or Twilio secret is required. No member mailbox OAuth configuration
# exists. See docs/exchange/microsoft-admin-marketing-email.md.
