rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && (request.auth.token.role == "admin" || request.auth.token.role == "master");
    }

    function isStaff() {
      return isAdmin() || (isSignedIn() && request.auth.token.role == "staff");
    }

    function isValidSize(maxBytes) {
      return request.resource.size > 0 && request.resource.size <= maxBytes;
    }

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    function isVideo() {
      return request.resource.contentType.matches('video/(mp4|webm|quicktime)');
    }

    function isPrivateDocument() {
      return request.resource.contentType.matches(
        '(application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document|text/plain|image/jpeg|image/png|image/webp)'
      );
    }

    // Client-created legacy assets are normalized by a finalize trigger. New
    // RFx/referral objects bypass this surface entirely and use the authenticated
    // byte-transfer Function. Arbitrary cache/disposition metadata is forbidden.
    function hasSafeSensitiveCreateMetadata() {
      return request.resource.metadata.keys().hasOnly([])
        && (request.resource.contentDisposition == null
            || request.resource.contentDisposition == ""
            || request.resource.contentDisposition == "attachment"
            || request.resource.contentDisposition == "inline")
        && (request.resource.contentEncoding == null
            || request.resource.contentEncoding == ""
            || request.resource.contentEncoding == "identity");
    }

    function isTeamMember(teamId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/rfxTeams/$(teamId))
        && (isStaff()
            || ("rfxId" in firestore.get(/databases/(default)/documents/rfxTeams/$(teamId)).data
                && "memberUids" in firestore.get(/databases/(default)/documents/rfxTeams/$(teamId)).data
                && request.auth.uid in firestore.get(/databases/(default)/documents/rfxTeams/$(teamId)).data.memberUids
                && firestore.exists(/databases/(default)/documents/rfxTeamMemberships/$(teamId)/members/$(request.auth.uid))
                && firestore.get(/databases/(default)/documents/rfxTeamMemberships/$(teamId)/members/$(request.auth.uid)).data.id == request.auth.uid
                && firestore.get(/databases/(default)/documents/rfxTeamMemberships/$(teamId)/members/$(request.auth.uid)).data.uid == request.auth.uid
                && firestore.get(/databases/(default)/documents/rfxTeamMemberships/$(teamId)/members/$(request.auth.uid)).data.teamId == teamId
                && firestore.get(/databases/(default)/documents/rfxTeamMemberships/$(teamId)/members/$(request.auth.uid)).data.rfxId == firestore.get(/databases/(default)/documents/rfxTeams/$(teamId)).data.rfxId));
    }

    function hasPublishedProfile(uid) {
      return firestore.exists(/databases/(default)/documents/publicProfiles/$(uid))
        && firestore.get(/databases/(default)/documents/publicProfiles/$(uid)).data.published == true
        && firestore.get(/databases/(default)/documents/publicProfiles/$(uid)).data.uid == uid;
    }

    function isSelectedCapabilityStatement(uid, fileName) {
      return hasPublishedProfile(uid)
        && "capabilityStatementStoragePath" in firestore.get(/databases/(default)/documents/publicProfiles/$(uid)).data
        && firestore.get(/databases/(default)/documents/publicProfiles/$(uid)).data.capabilityStatementStoragePath
          == "capabilityStatements/" + uid + "/" + fileName;
    }

    function isSelectedProfilePhoto(uid, fileName) {
      return hasPublishedProfile(uid)
        && (("photoStoragePath" in firestore.get(/databases/(default)/documents/publicProfiles/$(uid)).data
              && firestore.get(/databases/(default)/documents/publicProfiles/$(uid)).data.photoStoragePath
                == "profilePhotos/" + uid + "/" + fileName)
            || ("videoIntroPosterStoragePath" in firestore.get(/databases/(default)/documents/publicProfiles/$(uid)).data
              && firestore.get(/databases/(default)/documents/publicProfiles/$(uid)).data.videoIntroPosterStoragePath
                == "profilePhotos/" + uid + "/" + fileName));
    }

    function isSelectedProfileVideo(uid, variant, fileName) {
      return hasPublishedProfile(uid)
        && (((variant == "processed")
              && "videoIntroStoragePath" in firestore.get(/databases/(default)/documents/publicProfiles/$(uid)).data
              && firestore.get(/databases/(default)/documents/publicProfiles/$(uid)).data.videoIntroStoragePath
                == "profileVideos/" + uid + "/" + variant + "/" + fileName)
            || ((variant == "posters")
              && "videoIntroPosterStoragePath" in firestore.get(/databases/(default)/documents/publicProfiles/$(uid)).data
              && firestore.get(/databases/(default)/documents/publicProfiles/$(uid)).data.videoIntroPosterStoragePath
                == "profileVideos/" + uid + "/" + variant + "/" + fileName));
    }

    // A published profile grants anonymous access to exactly the selected
    // immutable object. Drafts, siblings, raw history, and nested legacy files
    // remain owner/staff private.
    match /capabilityStatements/{uid}/{fileName} {
      allow read: if isOwner(uid) || isStaff() || isSelectedCapabilityStatement(uid, fileName);
      allow create: if isOwner(uid)
                    && isValidSize(10 * 1024 * 1024)
                    && isPrivateDocument()
                    && hasSafeSensitiveCreateMetadata();
      allow update: if false;
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /capabilityStatements/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isStaff();
      allow write: if false;
    }

    match /profilePhotos/{uid}/{fileName} {
      allow read: if isOwner(uid) || isStaff() || isSelectedProfilePhoto(uid, fileName);
      allow create: if isOwner(uid)
                    && isValidSize(5 * 1024 * 1024)
                    && isImage()
                    && hasSafeSensitiveCreateMetadata();
      allow update: if false;
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /profilePhotos/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isStaff();
      allow write: if false;
    }

    match /profileVideos/{uid}/{variant}/{fileName} {
      allow read: if isOwner(uid) || isStaff() || isSelectedProfileVideo(uid, variant, fileName);
      allow create: if isOwner(uid)
                    && isValidSize(100 * 1024 * 1024)
                    && isVideo()
                    && hasSafeSensitiveCreateMetadata();
      allow update: if false;
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /profileVideos/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isStaff();
      allow write: if false;
    }

    // Verification evidence is private and path-bound to the submitting account.
    match /verificationDocs/{uid}/{docType}/{allPaths=**} {
      allow read: if isOwner(uid) || isStaff();
      allow create: if isOwner(uid)
                    && isValidSize(15 * 1024 * 1024)
                    && isPrivateDocument()
                    && hasSafeSensitiveCreateMetadata();
      allow update: if false;
      allow delete: if isAdmin()
                    || (isOwner(uid)
                        && !firestore.exists(/databases/(default)/documents/verificationEvidenceLocks/$(uid + "_" + docType)));
    }

    // Private RFx bytes use exchange_privateStorage. Denying client reads and
    // creates prevents Firebase bearer-token minting from bypassing a grant.
    match /rfxResponses/{rfxId}/{respondentUid}/{allPaths=**} {
      allow read, create: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Legacy RFx paths remain read-compatible for exact participants only.
    match /rfxProposals/{rfxId}/{respondentUid}/{allPaths=**} {
      allow read, write: if false;
    }

    match /rfxDocuments/{rfxId}/{respondentUid}/{allPaths=**} {
      allow read, write: if false;
    }

    // The older response-ID-keyed /proposals namespace has no trustworthy
    // respondent identity in its path. It intentionally falls through to the
    // final default deny until a separately reviewed migration can bind it.

    match /teamDocuments/{teamId}/{uploaderUid}/{allPaths=**} {
      allow read: if isTeamMember(teamId);
      allow create: if isOwner(uploaderUid)
                    && isTeamMember(teamId)
                    && isValidSize(25 * 1024 * 1024)
                    && isPrivateDocument()
                    && hasSafeSensitiveCreateMetadata();
      allow update: if false;
      allow delete: if (isOwner(uploaderUid) && isTeamMember(teamId)) || isAdmin();
    }

    match /businessReferralEvidence/{referralId}/{uploaderUid}/{allPaths=**} {
      allow read, create: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // The caller uploads before the server allocates a dispute ID, so the
    // canonical pre-create path is bound to referral and uploader identity.
    match /businessReferralDisputeEvidence/{referralId}/{uploaderUid}/{allPaths=**} {
      allow read, create: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Unrelated public application assets retain their established behavior.
    match /eventAssets/{eventId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidSize(5 * 1024 * 1024) && isImage();
      allow delete: if isAdmin();
    }

    match /event-media/{entityType}/{entityId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidSize(10 * 1024 * 1024) && isImage();
      allow delete: if isAdmin();
    }

    match /floorplanBackgrounds/{locationId}/{floorId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidSize(10 * 1024 * 1024) && isImage();
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
