{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "apps/functions",
    "region": "us-central1",
    "predeploy": [
      "npm run build:shared",
      "npm run build:functions"
    ]
  },
  "hosting": {
    "public": "apps/web/out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "redirects": [
      { "source": "/dashboard", "destination": "/account/bookings", "type": 301 },
      { "source": "/dashboard/**", "destination": "/account/bookings", "type": 301 },
      { "source": "/profile", "destination": "/account/bookings", "type": 301 },
      { "source": "/profile/**", "destination": "/account/bookings", "type": 301 },
      { "source": "/platform", "destination": "/", "type": 301 },
      { "source": "/platform/**", "destination": "/", "type": 301 },
      { "source": "/exchange", "destination": "/", "type": 301 },
      { "source": "/exchange/**", "destination": "/", "type": 301 },
      { "source": "/rfx", "destination": "/", "type": 301 },
      { "source": "/rfx/**", "destination": "/", "type": 301 },
      { "source": "/directory", "destination": "/", "type": 301 },
      { "source": "/directory/**", "destination": "/", "type": 301 },
      { "source": "/referrals", "destination": "/", "type": 301 },
      { "source": "/referrals/**", "destination": "/", "type": 301 },
      { "source": "/org", "destination": "/", "type": 301 },
      { "source": "/org/**", "destination": "/", "type": 301 },
      { "source": "/admin/rfx", "destination": "/admin/dashboard", "type": 301 },
      { "source": "/admin/rfx/**", "destination": "/admin/dashboard", "type": 301 },
      { "source": "/admin/territories", "destination": "/admin/dashboard", "type": 301 },
      { "source": "/admin/territories/**", "destination": "/admin/dashboard", "type": 301 },
      { "source": "/admin/verification", "destination": "/admin/dashboard", "type": 301 },
      { "source": "/admin/verification/**", "destination": "/admin/dashboard", "type": 301 },
      { "source": "/admin/orgs", "destination": "/admin/dashboard", "type": 301 },
      { "source": "/admin/orgs/**", "destination": "/admin/dashboard", "type": 301 },
      { "source": "/admin/analytics", "destination": "/admin/dashboard", "type": 301 },
      { "source": "/admin/analytics/**", "destination": "/admin/dashboard", "type": 301 }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9100
    },
    "functions": {
      "port": 5004
    },
    "firestore": {
      "port": 8081
    },
    "storage": {
      "port": 9199
    },
    "hosting": {
      "port": 5003
    },
    "ui": {
      "enabled": true
    }
  }
}
