{
  "name": "hi-coworking",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace web",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build:shared && npm run build --workspace web",
    "build:shared": "npm run build --workspace @hi/shared",
    "build:functions": "npm run build --workspace functions",
    "build:booking-public-deploy": "node -e \"require('fs').rmSync('firebase/booking-public-functions/lib',{recursive:true,force:true})\" && npm run build --workspace functions -- --project ../../firebase/booking-public-functions/tsconfig.json",
    "build:booking-transaction-deploy": "node -e \"require('fs').rmSync('firebase/booking-transaction-functions/lib',{recursive:true,force:true})\" && npm run build --workspace functions -- --project ../../firebase/booking-transaction-functions/tsconfig.json",
    "build:booking-deploy": "npm run build:booking-public-deploy && npm run build:booking-transaction-deploy",
    "build:admin-member-deploy": "node -e \"require('fs').rmSync('firebase/admin-member-functions/lib',{recursive:true,force:true})\" && npm run build --workspace functions -- --project ../../firebase/admin-member-functions/tsconfig.json",
    "build:payment-status-guard-deploy": "node -e \"require('fs').rmSync('firebase/payment-status-guard-functions/lib',{recursive:true,force:true})\" && npm run build --workspace functions -- --project ../../firebase/payment-status-guard-functions/tsconfig.json",
    "lint": "npm run lint --workspace web",
    "emulators": "firebase emulators:start",
    "deploy:booking:public": "firebase deploy --config firebase.booking.json --project hi-coworking-plat --only functions:booking-public",
    "deploy:booking:transactions": "firebase deploy --config firebase.booking.json --project hi-coworking-plat --only functions:booking-transactions",
    "deploy:booking": "npm run deploy:booking:public && npm run deploy:booking:transactions",
    "deploy:admin-member": "firebase deploy --config firebase.admin.json --project hi-coworking-plat --only functions:admin-member-ops",
    "deploy:payment-status-guard": "firebase deploy --config firebase.payment-status-guard.json --project hi-coworking-plat --only functions:admin_markPaymentStatus",
    "test": "npm run test:security",
    "test:rules": "firebase emulators:exec --project demo-hi-coworking --only firestore,storage \"vitest run tests/rules\"",
    "test:functions": "npm run build:shared && npm run build:functions && firebase emulators:exec --project demo-hi-coworking --only auth,firestore,functions,storage \"vitest run tests/functions\"",
    "test:migrations": "npm run build:functions && firebase emulators:exec --project demo-hi-coworking --only firestore \"vitest run tests/migrations\"",
    "test:security": "npm run build:shared && npm run build:functions && firebase emulators:exec --project demo-hi-coworking --only auth,firestore,functions,storage \"vitest run tests/rules tests/functions tests/migrations\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase-tools": "^15.23.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.19",
    "uuid": "^11.1.1",
    "universal-analytics": {
      ".": "0.5.3",
      "uuid": "^11.1.1"
    }
  }
}
