# Copy this file to apps/web/.env.local for local development.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-hi-coworking
# Optional guard used by profile diagnostics to detect an accidental project mismatch.
NEXT_PUBLIC_EXPECTED_FIREBASE_PROJECT_ID=demo-hi-coworking
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true

# Use a Mapbox public browser token beginning with pk.; never use an sk. secret token here.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.replace-with-your-mapbox-public-token
