# Opportunity and RFx discovery
# Copy these values into apps/web/.env.local or merge them into apps/web/.env.example.

# Existing public Mapbox token used by the Exchange map and temporary forward geocoding.
# Restrict this token to approved origins and required Mapbox scopes.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Mapbox Geocoding API v6 forward endpoint. Normally leave unchanged.
NEXT_PUBLIC_MAPBOX_GEOCODING_ENDPOINT=https://api.mapbox.com/search/geocode/v6/forward

# No hosted text-search provider is required by this branch.
# Do not add provider secrets to a NEXT_PUBLIC_* variable.
