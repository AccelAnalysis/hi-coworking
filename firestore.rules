rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    function isAdmin() {
      return hasRole("admin") || hasRole("master");
    }

    function isStaff() {
      return hasRole("staff") || isAdmin();
    }

    function isMember() {
      return isSignedIn(); // All authenticated users are at least members
    }

    function isOrgMember(orgId) {
      return isSignedIn()
        && orgId is string
        && exists(/databases/$(database)/documents/orgs/$(orgId))
        && get(/databases/$(database)/documents/orgs/$(orgId)).data.status == "active"
        && exists(/databases/$(database)/documents/orgMembers/$(orgId + "_" + request.auth.uid))
        && get(/databases/$(database)/documents/orgMembers/$(orgId + "_" + request.auth.uid)).data.orgId == orgId
        && get(/databases/$(database)/documents/orgMembers/$(orgId + "_" + request.auth.uid)).data.uid == request.auth.uid;
    }

    function isOrgManager(orgId) {
      return isOrgMember(orgId)
        && get(/databases/$(database)/documents/orgMembers/$(orgId + "_" + request.auth.uid)).data.role in ["owner", "admin"];
    }

    function ownsRfx(rfxData) {
      return isSignedIn()
        && (("orgId" in rfxData && isOrgMember(rfxData.orgId))
            || (!("orgId" in rfxData)
                && (("ownerUid" in rfxData && rfxData.ownerUid == request.auth.uid)
                    || ("createdBy" in rfxData && rfxData.createdBy == request.auth.uid))));
    }

    function canReadRfx(rfxData) {
      return isStaff()
        || ownsRfx(rfxData)
        || (rfxData.status == "open"
            && rfxData.adminApprovalStatus == "approved"
            && (rfxData.memberOnly == false || isSignedIn()));
    }

    function canReadRfxById(rfxId) {
      return exists(/databases/$(database)/documents/rfx/$(rfxId))
        && canReadRfx(get(/databases/$(database)/documents/rfx/$(rfxId)).data);
    }

    function isLegacyReferralParty(referralData) {
      return isSignedIn()
        && ((("referrerOrgId" in referralData && isOrgMember(referralData.referrerOrgId))
              || (!("referrerOrgId" in referralData)
                  && referralData.referrerUid == request.auth.uid))
            || (isUnambiguousLegacyBusinessReferral(referralData)
                && legacyBusinessContactMayBeDisclosed(referralData)
                && !("providerOrgId" in referralData)
                && "providerUid" in referralData
                && referralData.providerUid == request.auth.uid)
            || (isUnambiguousLegacyBusinessReferral(referralData)
                && legacyBusinessContactMayBeDisclosed(referralData)
                && "providerOrgId" in referralData
                && isOrgMember(referralData.providerOrgId))
            || (isUnambiguousLegacyPlatformInvite(referralData)
                && "referredUid" in referralData
                && referralData.referredUid == request.auth.uid)
            || (isUnambiguousLegacyPlatformInvite(referralData)
                && "referredEmail" in referralData
                && request.auth.token.email_verified == true
                && request.auth.token.email == referralData.referredEmail)
            || (isUnambiguousLegacyPlatformInvite(referralData)
                && "invitedEmail" in referralData
                && request.auth.token.email_verified == true
                && request.auth.token.email == referralData.invitedEmail));
    }

    function isRfxResponseRespondent(responseData) {
      return isSignedIn()
        && (("respondentOrgId" in responseData
              && responseData.respondentOrgId is string
              && (!("orgId" in responseData)
                  || (responseData.orgId is string
                      && responseData.orgId == responseData.respondentOrgId))
              && isOrgMember(responseData.respondentOrgId))
            || (!("respondentOrgId" in responseData)
                && "orgId" in responseData
                && responseData.orgId is string
                && isOrgMember(responseData.orgId))
            || (!("respondentOrgId" in responseData)
                && !("orgId" in responseData)
                && responseData.respondentUid == request.auth.uid));
    }

    function isUnambiguousLegacyPlatformInvite(referralData) {
      return (!("type" in referralData) || referralData.type == "platform_invite")
        && (("referredEmail" in referralData && referralData.referredEmail is string)
            || ("invitedEmail" in referralData && referralData.invitedEmail is string)
            || ("inviteeUid" in referralData && referralData.inviteeUid is string)
            || ("referredUid" in referralData && referralData.referredUid is string))
        && !("providerUid" in referralData)
        && !("providerOrgId" in referralData)
        && !("clientName" in referralData)
        && !("clientEmail" in referralData)
        && !("clientPhone" in referralData)
        && !("clientCompany" in referralData);
    }

    function isUnambiguousLegacyBusinessReferral(referralData) {
      return (!("type" in referralData) || referralData.type == "business_intro")
        && (("providerUid" in referralData && referralData.providerUid is string)
            || ("providerOrgId" in referralData && referralData.providerOrgId is string)
            || ("clientName" in referralData && referralData.clientName is string)
            || ("clientEmail" in referralData && referralData.clientEmail is string)
            || ("clientPhone" in referralData && referralData.clientPhone is string)
            || ("clientCompany" in referralData && referralData.clientCompany is string))
        && !("referredEmail" in referralData)
        && !("invitedEmail" in referralData)
        && !("inviteeUid" in referralData)
        && !("referredUid" in referralData)
        && !("claimedByUid" in referralData)
        && !("cancelledByUid" in referralData);
    }

    function legacyBusinessContactMayBeDisclosed(referralData) {
      return (!("clientName" in referralData)
              && !("clientEmail" in referralData)
              && !("clientPhone" in referralData)
              && !("clientCompany" in referralData))
        || ("consentStatus" in referralData && referralData.consentStatus == "confirmed")
        || ("recipientDisclosureAllowed" in referralData
            && referralData.recipientDisclosureAllowed == true);
    }

    function isBusinessReferralParty(referralData) {
      return isSignedIn()
        && (isBusinessReferralReferrer(referralData)
            || isBusinessReferralRecipient(referralData)
            || isAssignedReferralStaff(referralData));
    }

    function isAssignedReferralStaff(referralData) {
      return hasRole("staff")
        && "assignedStaffUids" in referralData
        && referralData.assignedStaffUids is list
        && request.auth.uid in referralData.assignedStaffUids;
    }

    function isBusinessReferralReferrer(referralData) {
      return isSignedIn()
        && (("referrerOrgId" in referralData && isOrgMember(referralData.referrerOrgId))
            || (!("referrerOrgId" in referralData)
                && referralData.referrerUid == request.auth.uid));
    }

    function isBusinessReferralRecipient(referralData) {
      return isSignedIn()
        && (("recipientOrgId" in referralData && isOrgMember(referralData.recipientOrgId))
            || (!("recipientOrgId" in referralData)
                && "recipientUid" in referralData
                && referralData.recipientUid == request.auth.uid));
    }

    function hasMemberUid(memberUids) {
      return memberUids is list && request.auth.uid in memberUids;
    }

    function hasTeamMembershipGuard(teamId, rfxId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/rfxTeamMemberships/$(teamId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/rfxTeamMemberships/$(teamId)/members/$(request.auth.uid)).data.id == request.auth.uid
        && get(/databases/$(database)/documents/rfxTeamMemberships/$(teamId)/members/$(request.auth.uid)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/rfxTeamMemberships/$(teamId)/members/$(request.auth.uid)).data.teamId == teamId
        && get(/databases/$(database)/documents/rfxTeamMemberships/$(teamId)/members/$(request.auth.uid)).data.rfxId == rfxId;
    }

    function isTeamMemberDoc(teamId, teamData) {
      return isSignedIn()
        && (isAdmin()
            || ("rfxId" in teamData
                && teamData.rfxId is string
                && hasMemberUid(teamData.memberUids)
                && hasTeamMembershipGuard(teamId, teamData.rfxId)));
    }

    function isTeamMemberByTeamId(teamId) {
      return isSignedIn()
        && (isAdmin()
            || (exists(/databases/$(database)/documents/rfxTeams/$(teamId))
                && isTeamMemberDoc(
                  teamId,
                  get(/databases/$(database)/documents/rfxTeams/$(teamId)).data
                )));
    }

    // --- users/{uid} ---
    // Owner can read/update their own doc; admins can read/write any user doc.
    // User doc is created by the authBeforeCreate Cloud Function, not client-side.
    match /users/{uid} {
      allow read: if isOwner(uid) || isStaff();
      allow update: if isAdmin()
                    || (isOwner(uid)
                        && request.resource.data.uid == resource.data.uid
                        && request.resource.data.email == resource.data.email
                        && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(["displayName", "membershipTrack", "updatedAt"]));
      allow create, delete: if false; // Only Cloud Functions create/delete user docs
    }

    // --- profiles/{uid} ---
    // Private authoritative profile. Public directory reads use publicProfiles.
    match /profiles/{uid} {
      allow read: if isOwner(uid) || isStaff();
      allow create, update, delete: if false;
    }

    // Sanitized server-maintained directory projection.
    match /publicProfiles/{uid} {
      allow read: if resource.data.published == true;
      allow create, update, delete: if false;
    }

    // --- orgs/{orgId} ---
    // Admins can manage orgs. Members can read orgs they belong to.
    match /orgs/{orgId} {
      allow read: if isStaff() || isOrgMember(orgId);
      allow create, update, delete: if isAdmin();
    }

    // --- orgMembers/{orgId}_{uid} ---
    // Composite key doc: org admin or platform admin can manage; member can read own.
    match /orgMembers/{docId} {
      allow read: if isSignedIn()
                  && (resource.data.uid == request.auth.uid
                      || isOrgManager(resource.data.orgId)
                      || isStaff());
      allow create, update, delete: if isAdmin();
    }

    // --- rfx/{rfxId} ---
    // Public read if not member-only; member-only requires auth.
    // Authenticated users can create; owner or admin can update/delete.
    match /rfx/{rfxId} {
      allow read: if canReadRfx(resource.data);
      allow create, update, delete: if false;
    }

    // --- rfxResponses/{responseId} ---
    // Respondent can read/create their own responses; RFx owner and admins can read.
    // RFx owner can update status (accept/decline); respondent can update their own.
    match /rfxResponses/{responseId} {
      allow read: if isSignedIn()
                  && ((isRfxResponseRespondent(resource.data)
                      || (exists(/databases/$(database)/documents/rfx/$(resource.data.rfxId))
                          && ownsRfx(get(/databases/$(database)/documents/rfx/$(resource.data.rfxId)).data))
                      || isStaff()));
      allow create, update, delete: if false;
    }

    // --- rfxTeams/{teamId} ---
    // Team members (and admin) can read; writes are server-authoritative.
    match /rfxTeams/{teamId} {
      allow read: if isTeamMemberDoc(teamId, resource.data);
      allow create, update, delete: if false;
    }

    // --- teamDocuments/{docId} ---
    // Team members can read/upload; uploader or admin can edit/delete.
    match /teamDocuments/{docId} {
      allow read: if resource.data.teamId is string
                  && isTeamMemberByTeamId(resource.data.teamId);
      allow create, update, delete: if false;
    }

    // --- referrals/{referralId} ---
    // Preserve legacy mixed records without granting unassigned staff access to
    // third-party business-introduction data.
    match /referrals/{referralId} {
      allow read: if isAdmin()
                  || isLegacyReferralParty(resource.data)
                  || isAssignedReferralStaff(resource.data)
                  || (isUnambiguousLegacyPlatformInvite(resource.data) && isStaff());
      allow create, update, delete: if false;
    }

    // New primary Exchange business-referral domain.
    match /businessReferrals/{referralId} {
      allow read: if isAdmin() || isBusinessReferralParty(resource.data);
      allow create, update, delete: if false;
    }

    // Third-party contact details remain hidden from recipients until consent.
    match /businessReferralContacts/{referralId} {
      allow read: if isAdmin()
                  || isBusinessReferralReferrer(resource.data)
                  || (exists(/databases/$(database)/documents/businessReferrals/$(referralId))
                      && isAssignedReferralStaff(
                        get(/databases/$(database)/documents/businessReferrals/$(referralId)).data
                      ))
                  || (resource.data.recipientDisclosureAllowed == true
                      && isBusinessReferralRecipient(resource.data));
      allow create, update, delete: if false;
    }

    match /platformInvites/{inviteId} {
      allow read: if isStaff()
                  || (isSignedIn()
                      && (resource.data.inviterUid == request.auth.uid
                          || (request.auth.token.email_verified == true
                              && request.auth.token.email == resource.data.invitedEmail)));
      allow create, update, delete: if false;
    }

    match /referralPolicies/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.id == uid
                    && request.resource.data.keys().hasOnly([
                      "id", "uid", "acceptingReferrals", "template", "terms",
                      "attributionWindowDays", "payoutTrigger", "customTerms",
                      "createdAt", "updatedAt"
                    ]);
      allow update: if isOwner(uid)
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.id == resource.data.id
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      "acceptingReferrals", "template", "terms", "attributionWindowDays",
                      "payoutTrigger", "customTerms", "updatedAt"
                    ]);
      allow delete: if isAdmin();
    }

    match /businessReferralDisputes/{disputeId} {
      allow read: if isAdmin()
                  || (exists(/databases/$(database)/documents/businessReferrals/$(resource.data.referralId))
                      && isBusinessReferralParty(get(/databases/$(database)/documents/businessReferrals/$(resource.data.referralId)).data));
      allow create, update, delete: if false;
    }

    // Compatibility boundary for any pre-Run-1 dispute records.
    match /referralDisputes/{disputeId} {
      allow read: if isAdmin()
                  || (exists(/databases/$(database)/documents/businessReferrals/$(resource.data.referralId))
                      && isBusinessReferralParty(get(/databases/$(database)/documents/businessReferrals/$(resource.data.referralId)).data))
                  || (exists(/databases/$(database)/documents/referrals/$(resource.data.referralId))
                      && isLegacyReferralParty(get(/databases/$(database)/documents/referrals/$(resource.data.referralId)).data));
      allow create, update, delete: if false;
    }

    // --- events/{eventId} ---
    // Events v2 exposes a sanitized public projection through Cloud Functions.
    // Raw event documents may contain private joining or operational metadata.
    match /events/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;

      // Legacy nested registrations remain readable only by their owner/admin
      // during migration; all writes are server-authoritative.
      match /registrations/{uid} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update, delete: if false;
      }

      match /waitlist/{uid} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update, delete: if false;
      }

      match /sponsors/{sponsorId} {
        allow read: if isAdmin();
        allow create, update, delete: if false;
      }

      match /vendorTables/{tableId} {
        allow read: if isAdmin();
        allow create, update, delete: if false;
      }
    }

    // --- eventSeries/{seriesId} ---
    // Recurring-series management remains an advanced admin workflow.
    match /eventSeries/{seriesId} {
      allow read, write: if isAdmin();
    }

    // --- eventCampaigns/{campaignId} ---
    // Admin manages campaign targeting and scheduling.
    match /eventCampaigns/{campaignId} {
      allow read, write: if isAdmin();
    }

    // --- campaignJobs/{jobId} ---
    // Queue is server/admin controlled.
    match /campaignJobs/{jobId} {
      allow read, write: if isAdmin();
    }

    // --- eventShareKits/{shareKitId} ---
    // Admin generates and approves social kits.
    match /eventShareKits/{shareKitId} {
      allow read, write: if isAdmin();
    }

    // --- socialPosts/{postId} ---
    // Admin or backend social queue access.
    match /socialPosts/{postId} {
      allow read, write: if isAdmin();
    }

    // --- payments/{paymentId} ---
    // Owner + admin read; only Cloud Functions write.
    match /payments/{paymentId} {
      allow read: if isSignedIn()
                  && (resource.data.uid == request.auth.uid || isAdmin());
      allow create, update, delete: if false; // Cloud Functions only
    }

    // --- webhookEvents/{eventId} ---
    // Idempotency table — Cloud Functions only.
    match /webhookEvents/{eventId} {
      allow read, write: if false;
    }

    // --- leads/{leadId} ---
    // Cloud Functions create (admin SDK bypasses rules); admin read.
    match /leads/{leadId} {
      allow read: if isAdmin();
      allow create: if false; // Cloud Functions only (protected by reCAPTCHA)
      allow update, delete: if isAdmin();
    }

    // --- siteSettings/{docId} ---
    // Public read for feature gating; admin update.
    match /siteSettings/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // --- territories/{fips} ---
    // Authenticated users can read territory metadata; admin/master manage.
    match /territories/{fips} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    // --- verificationDocuments/{docId} ---
    // Owner + staff/admin read; writes are server-authoritative.
    match /verificationDocuments/{docId} {
      allow read: if isStaff()
                  || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // --- verificationAuditLog/{auditId} ---
    // Owner + staff/admin read; writes are server-authoritative.
    match /verificationAuditLog/{auditId} {
      allow read: if isStaff()
                  || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /verificationFlags/{flagId} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }

    // --- userSuggestions/{uid} ---
    // Owner or admin read cached suggestions; Cloud Functions write.
    match /userSuggestions/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update, delete: if false;
    }

    // --- integrations/{orgId}/quickbooks/config ---
    // Admin-only; contains encrypted OAuth tokens.
    match /integrations/{orgId}/quickbooks/{docId} {
      allow read, write: if isAdmin();
    }

    // --- bookings/{bookingId} ---
    // Owner can read their bookings; staff+ can read all; Cloud Functions create.
    match /bookings/{bookingId} {
      allow read: if isSignedIn()
                  && (resource.data.userId == request.auth.uid || isStaff());
      allow create: if false; // Cloud Functions only (slot locking transaction)
      allow update: if isStaff(); // Staff can update status (e.g. cancel)
      allow delete: if isAdmin();
    }

    // --- floorplans/{floorplanId} ---
    // Public read (displayed on spaces page); admin write.
    match /floorplans/{floorplanId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // --- locations/{locationId} ---
    // Public read for booking/browsing; admin write for builder operations.
    match /locations/{locationId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      // --- locations/{locationId}/floors/{floorId} ---
      match /floors/{floorId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();

        // --- locations/{locationId}/floors/{floorId}/shell/{shellDocId} ---
        match /shell/{shellDocId} {
          allow read: if true;
          allow create, update, delete: if isAdmin();
        }

        // --- locations/{locationId}/floors/{floorId}/layouts/{layoutId} ---
        match /layouts/{layoutId} {
          allow read: if true;
          allow create, update, delete: if isAdmin();
        }
      }
    }

    // --- notifications/{notifId} ---
    // Owner read/update (mark read); Cloud Functions create.
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if isSignedIn()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(["read", "readAt"]);
      allow create, delete: if false; // Cloud Functions only
    }

    // --- products/{productId} ---
    // Public read for active products; admin write.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // --- paymentAudit/{auditId} ---
    // Admin-only read; Cloud Functions write.
    match /paymentAudit/{auditId} {
      allow read: if isAdmin();
      allow create, update, delete: if false; // Cloud Functions only
    }

    // --- rfxTeamInvites/{inviteId} ---
    // Inviter or invitee can read; members can create; invitee can update status; admin full access.
    match /rfxTeamInvites/{inviteId} {
      allow read: if isSignedIn()
                  && (resource.data.inviterUid == request.auth.uid
                      || resource.data.inviteeUid == request.auth.uid
                      || ("teamId" in resource.data && isTeamMemberByTeamId(resource.data.teamId))
                      || isStaff());
      allow create, update, delete: if false;
    }

    match /rfxTeamInviteAmbiguities/{ambiguityId} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }

    match /rfxTeamInviteGuards/{guardId} {
      allow read, write: if false;
    }

    // Authoritative membership guards are written only by trusted server
    // transactions and the reviewed backfill. Team arrays alone grant nothing.
    match /rfxTeamMemberships/{teamId} {
      allow read, write: if false;

      match /members/{uid} {
        allow read, write: if false;
      }
    }

    match /rfxTeamMembershipReviews/{teamId} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }

    match /rfxTeamInviteReviews/{reviewId} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }

    match /exchangeAudit/{auditId} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }

    match /exchangeIdempotency/{idempotencyId} {
      allow read, write: if false;
    }

    match /exchangeUsage/{uid} {
      allow read, write: if false;
    }

    match /rfxResponseAccess/{rfxId} {
      allow read, write: if false;

      match /respondents/{respondentUid} {
        allow read, write: if false;
      }
    }

    match /rfxResponseUploadGrantScopes/{rfxId} {
      allow read, write: if false;

      match /uploadGrants/{respondentUid} {
        allow read, write: if false;
      }
    }

    match /verificationEvidenceLocks/{lockId} {
      allow read, write: if false;
    }

    match /legacyReferralMappings/{legacyId} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }

    match /savedExchangeItems/{itemId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.entityType == "rfx"
                    && request.resource.data.id == itemId
                    && itemId == request.auth.uid + "_rfx_" + request.resource.data.entityId
                    && request.resource.data.keys().hasOnly(["id", "uid", "entityType", "entityId", "createdAt"])
                    && exists(/databases/$(database)/documents/rfx/$(request.resource.data.entityId));
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // --- books/{bookId} ---
    // Public read for published books; admin CRUD.
    match /books/{bookId} {
      allow read: if isAdmin()
                  || (resource.data.published == true);
      allow create, update, delete: if isAdmin();
    }

    // --- bookPurchases/{purchaseId} ---
    // Owner can read their purchases; admin can read all. Anyone can create (guest checkout).
    match /bookPurchases/{purchaseId} {
      allow read: if isSignedIn()
                  && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    // --- bookAffiliateClicks/{clickId} ---
    // Anyone can create (tracking); admin can read.
    match /bookAffiliateClicks/{clickId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if false;
    }

    // --- doors/{doorId} ---
    // Staff+ can read door config; all writes are Cloud Functions only.
    match /doors/{doorId} {
      allow read: if isStaff();
      allow create, update, delete: if false; // Cloud Functions + admin SDK only
    }

    // --- accessGrants/{grantId} ---
    // Owner can read their own grants; staff+ can read all; Cloud Functions write.
    match /accessGrants/{grantId} {
      allow read: if isSignedIn()
                  && (resource.data.userId == request.auth.uid || isStaff());
      allow create, update, delete: if false; // Cloud Functions only
    }

    // --- accessCodes/{codeId} ---
    // Owner of the linked grant can read (for status); staff+ can read all.
    // No client writes — PIN is never exposed via client path.
    match /accessCodes/{codeId} {
      allow read: if isStaff();
      allow create, update, delete: if false; // Cloud Functions only
    }

    // --- accessEvents/{eventId} ---
    // Audit trail: staff+ read only; Cloud Functions write.
    match /accessEvents/{eventId} {
      allow read: if isStaff();
      allow create, update, delete: if false; // Cloud Functions only
    }

    // --- mail/{mailId} ---
    // Outbound mail queue: Cloud Functions write only (admin SDK); admin read for debugging.
    match /mail/{mailId} {
      allow read: if isAdmin();
      allow create, update, delete: if false; // Cloud Functions only
    }

    // --- powerNowConsentLog/{submissionId} ---
    // Power NOW consent log of record. Admin SDK only. Clients cannot read or write it.
    match /powerNowConsentLog/{submissionId} {
      allow read, write: if false;
    }
  }
}
